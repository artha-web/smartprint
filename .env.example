# SmartPrint V2 Environment Configuration

# Application URL (used for QR code links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (LibSQL / Turso / SQLite)
# For local dev: defaults to file:local.db automatically (zero setup needed)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ==============================================================================
# Document File Storage (Choose EITHER UploadThing OR Cloudflare R2)
# ==============================================================================

# Option A: UploadThing (uploadthing.com) - Easiest setup!
# Get this single token from: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Option B: Cloudflare R2 (S3-compatible)
# Leave blank if using UploadThing
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stationery-documents

# Note: If neither UploadThing nor Cloudflare R2 is configured,
# the app automatically falls back to local disk storage in .storage/ for development.

# ==============================================================================
# Scheduled 12-Hour Cleanup & Admin Seeding
# ==============================================================================
# Secret for automated cron cleanup endpoint (/api/cron/cleanup)
CRON_SECRET=super_secret_cron_token_123

# Initial admin seeding (optional defaults used if empty)
ADMIN_EMAIL=admin@smartprint.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Shop Owner
SHOP_NAME=Royal Xerox & Stationery
SHOP_CODE=royal-xerox
